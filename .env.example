# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it is in .gitignore.

# ── Supabase ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Gmail SMTP (transactional email: invitations, sign-off) ───────
# Use your Gmail address and an App Password (NOT your regular password).
# To create an App Password: Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── App ───────────────────────────────────────────────────────────
# For local dev: http://localhost:3000
# For Vercel:    https://your-project.vercel.app  (or your custom domain)
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# Monday.com property integrations
# Used to encrypt property-scoped Monday API tokens at rest.
MONDAY_CREDENTIAL_ENCRYPTION_KEY=<32-plus-character-secret>
MONDAY_API_VERSION=2026-04

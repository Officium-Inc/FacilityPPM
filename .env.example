# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it is in .gitignore.

# ── Supabase ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Resend (transactional email: invitations, sign-off) ───────────
# Get your API key at https://resend.com
# Supabase SMTP is only for auth emails (password reset, magic links).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── App ───────────────────────────────────────────────────────────
# For local dev: http://localhost:3000
# For Vercel:    https://your-project.vercel.app  (or your custom domain)
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app


# ── Supabase ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Email (SMTP) ──────────────────────────────────────────────────
# Use the same SMTP credentials configured in Supabase → Auth → SMTP settings.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false          # true only for port 465
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@yourdomain.com

# Legacy Resend key — only used as FROM fallback if SMTP_FROM is not set
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── App ───────────────────────────────────────────────────────────
# For local dev: http://localhost:3000
# For Vercel:    https://your-project.vercel.app  (or your custom domain)
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
